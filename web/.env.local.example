# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: rider apply (create auth user + upload documents). Dashboard → Settings → API → service_role.
# Never expose this in client bundles or commit real keys.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: canonical site URL for auth emails (defaults to window origin in the browser)
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Run: npm run seed:users (creates/resets admin@crispy.com + rider@crispy.com; see scripts/seed-portal-users.mjs)
# Use strong passwords (12+ characters). Never commit real values.
# SEED_ADMIN_PASSWORD=
# SEED_RIDER_PASSWORD=
